# DevNode landing — production .htaccess
# Static site, no application layer. LinkStack has been retired: nothing here
# contains, blocks or redirects it any more.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical: force HTTPS + non-www (X-Forwarded-Proto guard avoids a
  # redirect loop if TLS ever terminates at an upstream proxy/CDN)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://mariuszmachuta.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://mariuszmachuta.com%{REQUEST_URI} [L,R=301]

  # This site emits zero PHP. Nothing should ever execute one, so deny outright
  # rather than rely on no handler being configured.
  RewriteRule \.php$ - [F,L]

  # Blanket dot-file/dot-directory deny: .env, .git/, editor and tooling dot
  # dirs. ACME must stay reachable or certificate renewal breaks.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F,L]

  # Backups, dumps and archives that must never be served.
  RewriteRule \.(bak|old|orig|sql|sqlite|zip|tar|gz|log|ini)$ - [F,L]

  # Collapse /index.html onto the canonical /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # No catch-all redirect. Unknown URLs return a genuine 404 rather than a 301
  # to the homepage — the latter is a soft-404 pattern that tells crawlers the
  # homepage is the correct destination for arbitrary paths. The old rule
  # existed only to catch retired LinkStack slugs; LinkStack is gone.
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; font-src 'self'; style-src 'self'; script-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  # Enable once HTTPS is confirmed stable:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Immutable caching for hashed build assets; fonts are NOT hash-named, so
  # they get 30 days with revalidation instead of a year of immutable
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(woff2|png|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # noscript.css is copied verbatim from public/ and is NOT content-hashed, so
  # it must not inherit the immutable rule above — editing it would otherwise
  # leave no-JS visitors on a stale copy for a year with no way to bust it.
  # Must stay after the .(css|js) block: later matches win.
  <Files "noscript.css">
    Header set Cache-Control "public, max-age=2592000"
  </Files>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

AddType font/woff2 .woff2
AddType image/svg+xml .svg

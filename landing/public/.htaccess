# DevNode landing — production .htaccess
# Replaces the LinkStack front-controller rewrite. Back up the old file as
# .htaccess.linkstack.bak before uploading; restoring it is the rollback.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical: force HTTPS + non-www (X-Forwarded-Proto guard avoids a
  # redirect loop if TLS ever terminates at an upstream proxy/CDN)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://mariuszmachuta.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://mariuszmachuta.com%{REQUEST_URI} [L,R=301]

  # Block dormant LinkStack/Laravel internals while they remain on disk
  RewriteRule ^(app|bootstrap|config|database|storage|vendor|routes|resources|themes|backups)(/|$) - [F,L]
  RewriteRule ^(\.env|composer\.(json|lock)|artisan|server\.php|web\.config|package\.json|webpack\.mix\.js) - [F,L]

  # Collapse /index.html onto the canonical /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Any extension-less URL that is not an existing file → home (old LinkStack
  # slugs). URLs with a dot (missing assets) fall through to a genuine 404 so
  # a stale index.html never receives HTML where it expects JS/CSS.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.
  RewriteRule ^ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; font-src 'self'; style-src 'self'; script-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  # Enable once HTTPS is confirmed stable:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Immutable caching for hashed build assets; fonts are NOT hash-named, so
  # they get 30 days with revalidation instead of a year of immutable
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(woff2|png|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

AddType font/woff2 .woff2
AddType image/svg+xml .svg
